# Code-review repository: explicitly include source, configuration and documentation.
# Raw data, runtime environments and checkpoints stay on the research servers.
*
!*/
!.gitignore
!.gitattributes
!*.py
!*.sh
!*.toml
!*.yaml
!*.yml
!*.md
!*.tex
!*.bib
!*.cls
!*.sty
!*.bst
!LICENSE*
!NOTICE*
!requirements*.txt
!project/project
!project/*.json
!project/configs/*.json
!project/environment/*.txt
!project/data/*.json
!project/runs/*/PROTOCOL.json
!project/runs/*/QC_RULES.json
!project/runs/*/STATUS.json
!project/runs/*/COMPLETE.json
!project/runs/*/COMPLETION_AUDIT.json
!project/runs/*/FROZEN_SELECTION.json
!project/runs/daily*/*.json
!project/runs/daily*/assets/*.json
!project/runs/daily*/assets/**/*.json
!project/runs/daily*/assets/*.csv
!project/runs/daily*/selection_inputs/*.json
!project/runs/daily*/analysis/*.csv
!project/runs/daily*/analysis/*.json
!project/analysis/**/*.csv
!project/analysis/**/*.json
!project/analysis/**/*.png
!project/analysis/**/*.svg
!docs/*.json

# Local archives, generated artifacts, datasets and environments.
/archives/
/project/.runtime/
/project/runtime/
/project/datasets/
/project/artifacts/
/project/output/
/project/provenance/
/project/historical_reports/
**/jobs
**/smoke_jobs/
**/feature_cache/
**/prepared/
**/pretrained/
**/checkpoints/
**/cache/
**/logs/
**/wandb/
**/node_modules/
**/build/
**/.venv/
**/__pycache__/
**/.pytest_cache/
**/*.egg-info/
**/.git/

# Credentials and local-only configuration are never published.
.env
.env.*
*.pem
*.key
*.p12
*.pfx
.netrc
.git-credentials
credentials*.json
*service_account*.json
*service-account*.json
id_rsa*
id_ed25519*
**/.ssh/
**/.codex/
**/.vscode/
/github_export/
